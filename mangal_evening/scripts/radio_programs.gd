		"Ловите бас, друзья! А после короткой паузы снова добавим громкости.",
		"У микрофона Макс. Следующий трек для тех, кто любит ритм и живой огонь."
	]
]
const WEATHER := [
	"Дворовый прогноз: к ночи воздух станет прохладнее. Возьмите кофту и не оставляйте угли без присмотра.",
	"Погода нашего вымышленного дворика: вечер обещает быть спокойным. Временами лёгкий ветер.",
	"Ближе к рассвету станет свежее. Горячий чай и тёплая куртка сегодня не помешают.",
	"На улице заметно темнеет. Самое время проверить угли и придвинуться к огню."
]

static func get_segment(station: int, category: String, sequence: int, time_minutes: float) -> Dictionary:
	var i: int = clampi(station, 0, 3)
	if category == "intro":
		return {"kind": "ЗАСТАВКА", "text": INTRO[i]}
	if category == "weather":
		var pick: int = (sequence + int(time_minutes / 60.0)) % WEATHER.size()
		return {"kind": "ПРОГНОЗ", "text": WEATHER[pick]}
	var pool: Array = HOST[i]
	return {"kind": "ВЕДУЩИЙ", "text": String(pool[sequence % pool.size()])}
