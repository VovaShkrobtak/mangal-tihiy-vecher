const RUSSIAN: Dictionary = {
	"А":"A", "Б":"11111/10000/10000/11110/10001/10001/11110", "В":"B",
	"Г":"11111/10000/10000/10000/10000/10000/10000",
	"Д":"00110/01010/01010/01010/01010/11111/10001",
	"Е":"E", "Ё":"11111/10000/10000/11110/10000/10000/11111",
	"Ж":"10101/10101/01110/00100/01110/10101/10101",
	"З":"11110/00001/00001/00110/00001/00001/11110",
	"И":"10001/10011/10101/10101/11001/10001/10001",
	"Й":"01110/10011/10101/10101/11001/10001/10001",
	"К":"K", "Л":"00111/01001/01001/01001/10001/10001/10001",
	"М":"M", "Н":"H", "О":"O",
	"П":"11111/10001/10001/10001/10001/10001/10001",
	"Р":"P", "С":"C", "Т":"T",
	"У":"10001/10001/01010/00100/01000/10000/10000",
	"Ф":"00100/01110/10101/10101/01110/00100/00100",
	"Х":"X",
	"Ц":"10010/10010/10010/10010/10010/11111/00001",
	"Ч":"10001/10001/10001/01111/00001/00001/00001",
	"Ш":"10101/10101/10101/10101/10101/10101/11111",
	"Щ":"10101/10101/10101/10101/10101/11111/00001",
	"Ъ":"11000/01000/01110/01001/01001/01001/01110",
	"Ы":"10001/10001/11101/10101/10101/10101/11101",
	"Ь":"10000/10000/11110/10001/10001/10001/11110",
	"Э":"11110/00001/00001/00111/00001/00001/11110",
	"Ю":"10010/10101/10101/11101/10101/10101/10010",
	"Я":"01111/10001/10001/01111/00101/01001/10001"
}

static func build() -> FontFile:
	if _font != null:
		return _font
	var glyphs: Dictionary = LATIN.duplicate()
	for key in RUSSIAN:
		var ref: String = String(RUSSIAN[key])
		glyphs[key] = LATIN[ref] if LATIN.has(ref) else ref
	var chars: String = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789 .,;:-_/!?()+%|=•№АБВГДЕЁЖЗИЙКЛМНОПРСТУФХЦЧШЩЪЫЬЭЮЯабвгдеёжзийклмнопрстуфхцчшщъыьэюя"
	var cell_width := 8
	var cell_height := 10
	var cols := 16
	var rows: int = ceili(float(chars.length()) / float(cols))
	var img := Image.create(cols * cell_width, rows * cell_height, false, Image.FORMAT_RGBA8)
	img.fill(Color(1, 1, 1, 0))
	var font := FontFile.new()
	font.fixed_size = 8
	font.antialiasing = TextServer.FONT_ANTIALIASING_NONE
	font.set_cache_ascent(0, 8, 7.0)
	font.set_cache_descent(0, 8, 1.0)
	for i in range(chars.length()):
		var ch := chars.substr(i, 1)
		var name: String = ch.to_upper()
		var pattern: String = String(glyphs.get(ch, glyphs.get(name, LATIN["?"])))
		var lines := pattern.split("/")
		var gx: int = (i % cols) * cell_width
		var gy: int = (i / cols) * cell_height
		for y in range(7):
			for x in range(5):
				if lines[y].substr(x, 1) == "1":
					img.set_pixel(gx + x, gy + y, Color.WHITE)
	font.set_texture_image(0, Vector2i(8, 0), 0, img)
	for i in range(chars.length()):
		var symbol := chars.substr(i, 1)
		var unicode: int = symbol.unicode_at(0)
		var x: int = (i % cols) * cell_width
		var y: int = (i / cols) * cell_height
		font.set_glyph_advance(0, 8, unicode, Vector2(6, 0))
		font.set_glyph_size(0, Vector2i(8, 0), unicode, Vector2(5, 7))
		font.set_glyph_offset(0, Vector2i(8, 0), unicode, Vector2(0, -7))
		font.set_glyph_uv_rect(0, Vector2i(8, 0), unicode, Rect2(x, y, 5, 7))
		font.set_glyph_texture_idx(0, Vector2i(8, 0), unicode, 0)
	_font = font
	return font
